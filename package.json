{
  "name": "feedscout",
  "description": "Advanced feed autodiscovery for JavaScript. Collect feed information from any webpage using multiple discovery methods.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/feedscout.git"
  },
  "homepage": "https://feedscout.dev",
  "bugs": {
    "url": "https://github.com/macieklamberski/feedscout/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "rss",
    "rss-autodiscovery",
    "autodiscovery",
    "auto-discovery",
    "feed-finder",
    "rss-finder",
    "feed-discovery",
    "rss-discovery",
    "feed-locator"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./feeds": {
      "types": "./dist/feeds.d.mts",
      "default": "./dist/feeds.mjs"
    },
    "./blogrolls": {
      "types": "./dist/blogrolls.d.mts",
      "default": "./dist/blogrolls.mjs"
    },
    "./favicons": {
      "types": "./dist/favicons.d.mts",
      "default": "./dist/favicons.mjs"
    },
    "./hubs": {
      "types": "./dist/hubs.d.mts",
      "default": "./dist/hubs.mjs"
    },
    "./methods": {
      "types": "./dist/methods.d.mts",
      "default": "./dist/methods.mjs"
    },
    "./platform": {
      "types": "./dist/platform.d.mts",
      "default": "./dist/platform.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/exports/index.ts src/exports/feeds.ts src/exports/blogrolls.ts src/exports/favicons.ts src/exports/hubs.ts src/exports/methods.ts src/exports/platform.ts --format esm --dts --clean --unbundle",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "htmlparser2": "^12.0.0",
    "http-link-header": "^1.1.4"
  },
  "peerDependencies": {
    "feedsmith": "^3.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/http-link-header": "^1.0.7",
    "feedsmith": "^3.0.0",
    "kvalita": "^1.23.0",
    "ogier": "^1.3.0",
    "trousse": "^2.2.1",
    "tsdown": "^0.23.0",
    "vitepress": "^2.0.0-alpha.20"
  }
}
