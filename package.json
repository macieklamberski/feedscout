{
  "name": "feedscout",
  "description": "Advanced feed autodiscovery for JavaScript. Collect feed information from any webpage using multiple discovery methods.",
  "repository": {
    "type": "git",
    "url": "https://github.com/macieklamberski/feedscout.git"
  },
  "homepage": "https://feedscout.dev",
  "bugs": {
    "url": "https://github.com/macieklamberski/feedscout/issues"
  },
  "license": "MIT",
  "author": "Maciej Lamberski",
  "sideEffects": false,
  "keywords": [
    "rss",
    "rss-autodiscovery",
    "autodiscovery",
    "auto-discovery",
    "feed-finder",
    "rss-finder",
    "feed-discovery",
    "rss-discovery",
    "feed-locator"
  ],
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./feeds": {
      "import": {
        "types": "./dist/feeds.d.ts",
        "default": "./dist/feeds.js"
      },
      "require": {
        "types": "./dist/feeds.d.cts",
        "default": "./dist/feeds.cjs"
      }
    },
    "./blogrolls": {
      "import": {
        "types": "./dist/blogrolls.d.ts",
        "default": "./dist/blogrolls.js"
      },
      "require": {
        "types": "./dist/blogrolls.d.cts",
        "default": "./dist/blogrolls.cjs"
      }
    },
    "./favicons": {
      "import": {
        "types": "./dist/favicons.d.ts",
        "default": "./dist/favicons.js"
      },
      "require": {
        "types": "./dist/favicons.d.cts",
        "default": "./dist/favicons.cjs"
      }
    },
    "./hubs": {
      "import": {
        "types": "./dist/hubs.d.ts",
        "default": "./dist/hubs.js"
      },
      "require": {
        "types": "./dist/hubs.d.cts",
        "default": "./dist/hubs.cjs"
      }
    },
    "./methods": {
      "import": {
        "types": "./dist/methods.d.ts",
        "default": "./dist/methods.js"
      },
      "require": {
        "types": "./dist/methods.d.cts",
        "default": "./dist/methods.cjs"
      }
    },
    "./utils": {
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      },
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "build": "tsdown src/exports/index.ts src/exports/feeds.ts src/exports/blogrolls.ts src/exports/favicons.ts src/exports/hubs.ts src/exports/methods.ts src/exports/utils.ts --format cjs,esm --dts --clean --unbundle --no-fixed-extension",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "dependencies": {
    "feedsmith": "^2.9.3",
    "htmlparser2": "^10.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "kvalita": "1.13.0",
    "tsdown": "^0.21.10",
    "vitepress": "^2.0.0-alpha.17"
  }
}
